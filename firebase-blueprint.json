{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Student or partner user profile containing delivery contact details and role assignment.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 20 },
        "hostelOrPg": { "type": "string", "maxLength": 120 },
        "roomDetails": { "type": "string", "maxLength": 80 },
        "landmark": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["customer", "retailer", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "role", "createdAt", "updatedAt"]
    },
    "Store": {
      "title": "Store",
      "description": "Participating local retailer store in Selaqui/DGU surroundings.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "category": { "type": "string", "enum": ["Kirana & Groceries", "Snacks & Beverages", "Stationery & Print", "Personal Care", "Multi-Category Essentials", "Licensed Pharmacy"] },
        "address": { "type": "string", "minLength": 3, "maxLength": 200 },
        "serviceAreas": { "type": "array", "description": "Up to 10 covered hostel/PG clusters" },
        "operatingHours": { "type": "string", "minLength": 2, "maxLength": 80 },
        "deliveryEstimateNote": { "type": "string", "maxLength": 140 },
        "whatsappOrderNumber": { "type": "string", "maxLength": 20 },
        "upiId": { "type": "string", "maxLength": 100 },
        "upiEnabled": { "type": "boolean" },
        "codEnabled": { "type": "boolean" },
        "pharmacyVerified": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "active", "suspended"] },
        "isDemo": { "type": "boolean" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "address", "serviceAreas", "operatingHours", "upiEnabled", "codEnabled", "pharmacyVerified", "status", "isDemo", "ownerUid", "createdAt", "updatedAt"]
    },
    "StorePrivateContact": {
      "title": "StorePrivateContact",
      "description": "Isolated PII for retailer contact person.",
      "type": "object",
      "properties": {
        "ownerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "registeredPhone": { "type": "string", "minLength": 5, "maxLength": 20 },
        "ownerEmail": { "type": "string", "maxLength": 150 },
        "notes": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerName", "registeredPhone", "updatedAt"]
    },
    "RetailerApplication": {
      "title": "RetailerApplication",
      "description": "Onboarding inquiry submitted by a local retailer pending admin verification.",
      "type": "object",
      "properties": {
        "applicantUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "ownerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "phone": { "type": "string", "minLength": 8, "maxLength": 20 },
        "whatsappNumber": { "type": "string", "maxLength": 20 },
        "address": { "type": "string", "minLength": 4, "maxLength": 200 },
        "category": { "type": "string", "maxLength": 60 },
        "serviceArea": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["applicantUid", "storeName", "ownerName", "phone", "address", "category", "serviceArea", "status", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Product offered by a participating local retailer.",
      "type": "object",
      "properties": {
        "storeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "category": { "type": "string", "enum": ["Groceries", "Snacks", "Beverages", "Stationery", "Personal Care", "Other Essentials"] },
        "description": { "type": "string", "maxLength": 400 },
        "price": { "type": "number" },
        "unitLabel": { "type": "string", "maxLength": 40 },
        "imageKey": { "type": "string", "maxLength": 60 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "available": { "type": "boolean" },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["storeId", "storeName", "name", "category", "description", "price", "unitLabel", "imageKey", "available", "isDemo", "createdAt", "updatedAt"]
    },
    "Bundle": {
      "title": "Bundle",
      "description": "Student-friendly bundle composed of configured store products.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "category": { "type": "string", "enum": ["Hostel Essentials Bundle", "Study Essentials Bundle", "Late-Night Snacks Bundle", "Personal Care Bundle", "Monthly Essentials Bundle"] },
        "description": { "type": "string", "maxLength": 300 },
        "storeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "items": { "type": "array", "description": "Up to 15 configured products with quantities" },
        "regularPrice": { "type": "number" },
        "bundlePrice": { "type": "number" },
        "enabled": { "type": "boolean" },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "description", "storeId", "storeName", "items", "regularPrice", "bundlePrice", "enabled", "isDemo", "createdAt", "updatedAt"]
    },
    "ServiceArea": {
      "title": "ServiceArea",
      "description": "Configurable hostel, PG, or campus cluster in Selaqui.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "clusterType": { "type": "string", "enum": ["Campus Hostel", "PG Cluster", "Campus Gate / Academic"] },
        "description": { "type": "string", "maxLength": 240 },
        "estimatedDeliveryNote": { "type": "string", "maxLength": 120 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "clusterType", "description", "estimatedDeliveryNote", "active", "createdAt", "updatedAt"]
    },
    "PlatformConfig": {
      "title": "PlatformConfig",
      "description": "Pilot financial assumptions, delivery fee, and WhatsApp configuration.",
      "type": "object",
      "properties": {
        "deliveryServiceFee": { "type": "number" },
        "variableCostPerTxn": { "type": "number" },
        "monthlyFixedCost": { "type": "number" },
        "baseMonthlyCustomers": { "type": "number" },
        "basePurchasesPerCustomer": { "type": "number" },
        "pilotWhatsappNumber": { "type": "string", "maxLength": 20 },
        "pilotFeeDisclaimer": { "type": "string", "maxLength": 240 },
        "promoBannerText": { "type": "string", "maxLength": 160 },
        "promoBannerEnabled": { "type": "boolean" },
        "upiEnabled": { "type": "boolean" },
        "codEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["deliveryServiceFee", "variableCostPerTxn", "monthlyFixedCost", "baseMonthlyCustomers", "basePurchasesPerCustomer", "pilotWhatsappNumber", "pilotFeeDisclaimer", "promoBannerEnabled", "upiEnabled", "codEnabled", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Student order request submitted for WhatsApp coordination and retailer confirmation.",
      "type": "object",
      "properties": {
        "orderRef": { "type": "string", "minLength": 3, "maxLength": 32 },
        "customerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "storeOwnerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "customerPhone": { "type": "string", "minLength": 8, "maxLength": 20 },
        "hostelOrPg": { "type": "string", "minLength": 2, "maxLength": 120 },
        "roomDetails": { "type": "string", "minLength": 1, "maxLength": 80 },
        "landmark": { "type": "string", "maxLength": 120 },
        "deliveryInstructions": { "type": "string", "maxLength": 240 },
        "items": { "type": "array", "description": "Up to 30 ordered line items" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["UPI", "COD"] },
        "paymentStatus": { "type": "string", "enum": ["Unverified", "Manually Verified", "Not Required Yet"] },
        "status": { "type": "string", "enum": ["Draft", "Pending Retailer Confirmation", "Accepted", "Rejected", "Confirmed", "Out for Delivery", "Completed", "Cancelled"] },
        "whatsappMessage": { "type": "string", "maxLength": 2000 },
        "retailerNote": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderRef", "customerUid", "storeId", "storeName", "storeOwnerUid", "customerName", "customerPhone", "hostelOrPg", "roomDetails", "items", "subtotal", "deliveryFee", "totalAmount", "paymentMethod", "paymentStatus", "status", "whatsappMessage", "createdAt", "updatedAt"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "Student pilot feedback and willingness-to-pay validation survey.",
      "type": "object",
      "properties": {
        "customerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "orderId": { "type": "string", "maxLength": 128 },
        "hostelCluster": { "type": "string", "minLength": 2, "maxLength": 100 },
        "willingToPayFee": { "type": "boolean" },
        "rating": { "type": "number" },
        "comment": { "type": "string", "minLength": 2, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerUid", "customerName", "hostelCluster", "willingToPayFee", "rating", "comment", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Admin role marker documents."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Student/customer profiles containing PII restricted to owner or admin."
    },
    "/stores/{storeId}": {
      "schema": { "$ref": "#/entities/Store" },
      "description": "Participating local retailer stores."
    },
    "/stores/{storeId}/private/contact": {
      "schema": { "$ref": "#/entities/StorePrivateContact" },
      "description": "Isolated retailer contact PII."
    },
    "/retailerApplications/{applicationId}": {
      "schema": { "$ref": "#/entities/RetailerApplication" },
      "description": "Local retailer onboarding applications."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Products listed by local retailers."
    },
    "/bundles/{bundleId}": {
      "schema": { "$ref": "#/entities/Bundle" },
      "description": "Student-friendly bundles managed by admin."
    },
    "/serviceAreas/{areaId}": {
      "schema": { "$ref": "#/entities/ServiceArea" },
      "description": "DGU / Selaqui hostel and PG service areas."
    },
    "/platformConfig/{configId}": {
      "schema": { "$ref": "#/entities/PlatformConfig" },
      "description": "Singleton pilot configuration (delivery fee, unit economics, WhatsApp)."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer order requests with storeOwnerUid and customerUid isolation."
    },
    "/feedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/Feedback" },
      "description": "Student pilot feedback and ₹20 willingness-to-pay validation."
    }
  }
}
